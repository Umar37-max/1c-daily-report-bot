# Copy to .env and fill in. .env is git-ignored; never commit real values.

# ── Google ──────────────────────────────────────────────────────────────
# Service-account key (JSON). Share the register spreadsheet with the
# service account's e-mail as Editor.
GOOGLE_CREDENTIALS_PATH=credentials/service_account.json
# NATIVE Google Sheet with the register (bare ID or full URL).
REGISTER_SPREADSHEET_ID=your-google-sheet-id
# Optional: ID of the original .xlsx on Google Drive (tools/convert_to_gsheet.py)
SOURCE_XLSX_FILE_ID=
REGISTER_SHEET=Регистр
REGISTER_HEADER_ROW=20
SUMMARY_SHEET=Sales by day
SUMMARY_RANGE=A19:K34

# ── Telegram ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Who receives the daily picture (comma-separated chat IDs)
TELEGRAM_CHAT_IDS=
# Group for the step-by-step run log (the bot must be a member)
TELEGRAM_LOG_CHAT_ID=
# Who may start uploads from the bot (comma-separated user IDs)
BOT_ADMIN_IDS=
# Who may request /shot and /status (defaults to TELEGRAM_CHAT_IDS)
BOT_VIEWER_IDS=

# ── 1C:Enterprise ───────────────────────────────────────────────────────
1c_login=
1c_password=
# Used when the infobase is not registered in ibases.v8i of this Windows user
ONEC_CONNECTION_STRING=ws=https://1c.example.com/base;
# Thin-client version the infobase needs, e.g. 8.3.22.2283 (empty = newest installed)
ONEC_CLIENT_VERSION=
# Optional: infobase name as registered in ibases.v8i
ONEC_IB_NAME=
# Optional: full path to 1cv8c.exe if it is not under C:\Program Files\1cv8
THIN_CLIENT_EXE_OVERRIDE=
# Substring of the 1C main window title (e.g. the infobase name)
ONEC_WINDOW_TITLE=1С:Предприятие
# 0 = start our own 1C instance and close it afterwards; 1 = attach to an open window
ONEC_REUSE_OPEN=0

# Report location in the 1C UI
REPORT_SECTION=Продажи
REPORT_MENU_ITEM=Отчеты по продажам
REPORT_TITLE=Валовая прибыль организаций - копия
# Client access groups excluded from the register (wholesale)
EXCLUDE_CLIENT_GROUPS=B2B,B2B new,optom
# Retail divisions to add to the workbook's channel formula when new stores open
RETAIL_DIVISIONS=

# ── Schedule ────────────────────────────────────────────────────────────
TIMEZONE=Asia/Tashkent
RUN_AT=06:30
# Max days per single 1C report (long periods are split into chunks)
MAX_CHUNK_DAYS=7
# Weekday to re-upload the last 7 days: 0=Monday .. 6=Sunday, -1 = never
WEEKLY_REFRESH_WEEKDAY=0

# ── Input layer (set in the process environment, e.g. start_bot.cmd) ───
# 1 = allow real mouse/keyboard input; default is fully virtual input
VIRTUAL_INPUT_ALLOW_REAL=0
# 1 = log which input layer served each action
VIRTUAL_INPUT_DEBUG=0
